# ─────────────────────────────────────────────────────────────
# IHK Prüfungsübersicht – environment template
# Copy this file to ".env" and adjust values. NEVER commit a real .env.
# ─────────────────────────────────────────────────────────────

# Public Google Spreadsheet ID (the "Prüfungsübersicht 2.0" sheet).
# This is public reference data, not a secret, but kept configurable.
GOOGLE_SHEET_ID=1jDFsBoQyzReOv-AxFAgrhAZkdimwp-oj7UT56pqf0Wk

# SQLite database file location (relative to backend/).
DATABASE_URL="file:./prisma/dev.db"

# Import schedule. Default: every 6 hours. Override via IMPORT_INTERVAL_HOURS.
IMPORT_INTERVAL_HOURS=6

# HTTP request delay between sheet fetches (ms). Helps avoid rate-limiting.
IMPORT_REQUEST_DELAY_MS=400

# API server port.
PORT=3001

# Admin shared secret for protected endpoints (POST /api/admin/import,
# GET /api/admin/*). Generate a strong random token, e.g.:
#   openssl rand -hex 32
# NEVER commit a real token. When unset, all admin endpoints return 503
# (disabled) — they cannot be used without a configured token.
ADMIN_TOKEN=

# ── Admin login (username + password, server-side verified) ───────────────
# The browser login at /admin/login verifies these SERVER-SIDE and issues an
# HttpOnly session cookie. The plaintext password is never stored in the DB or
# in source; either a scrypt hash (preferred) or a plaintext value (local dev
# only) is read from the environment. Admin endpoints stay enabled when at
# least one of ADMIN_TOKEN / ADMIN_PASSWORD(_HASH) is set.
#
# Initial local credentials: username "admin", password "dbasicherheit26".
# Generate the hash and paste it below (never commit the real value):
#   cd backend && npx tsx src/scripts/hash-admin-password.ts 'deinPasswort'
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Plaintext fallback — local development only. Leave empty in production.
ADMIN_PASSWORD=

# Session lifetime in hours (default 8).
ADMIN_SESSION_TTL_HOURS=8

# Login rate limiting: max failed attempts per (IP + username) window.
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MINUTES=15

# Comma-separated allowed origins for CSRF checks on cookie-authenticated
# state-changing requests (e.g. https://ihk.example.com). The request's own
# Host is always allowed, so same-origin local/Docker setups need no value.
APP_ORIGIN=

# Set to 1 to force the Secure flag on the session cookie even when
# NODE_ENV is not "production" (it is automatic in production).
ADMIN_COOKIE_SECURE=
