# ─────────────────────────────────────────────────────────────
# IHK Prüfungsübersicht – environment template
# Copy this file to ".env" and adjust values. NEVER commit a real .env.
# ─────────────────────────────────────────────────────────────

# Public Google Spreadsheet ID (the "Prüfungsübersicht 2.0" sheet).
# This is public reference data, not a secret, but kept configurable.
GOOGLE_SHEET_ID=1jDFsBoQyzReOv-AxFAgrhAZkdimwp-oj7UT56pqf0Wk

# SQLite database file location (relative to backend/).
DATABASE_URL="file:./prisma/dev.db"

# Import schedule (cron). Default: every 6 hours.
IMPORT_CRON="0 */6 * * *"

# HTTP request delay between sheet fetches (ms). Helps avoid rate-limiting.
IMPORT_REQUEST_DELAY_MS=400

# Server port for the API (later phases).
API_PORT=3001
